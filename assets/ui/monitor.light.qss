/* 监控页 · 浅色主题（改完存盘自动生效，不用重启） */

QWidget#monitorRoot {
    background: transparent;
}

QFrame#monitorCard {
    background: #ffffff;
    border: 1px solid #e4e4e4;
    border-radius: 8px;
}

QFrame#monitorDivider {
    background: #e8e8e8;
}

QFrame#monitorSplitHandle {
    background: #e8e8e8;
    border-radius: 1px;
}

QFrame#monitorSplitHandle[editing="true"] {
    margin: 0 3px;
}

QFrame#monitorSplitHandle:hover {
    background: #0f6cbd;
}

QFrame#monitorRow {
    border-bottom: 1px dashed #ececec;
}

QFrame#monitorHalo {
    background: rgba(46, 160, 110, 40);
    border-radius: 8px;
}

QFrame#monitorDot {
    background: #9a9a9a;
    border-radius: 4px;
}

QFrame#monitorDot[state="running"] { background: #2ea06e; }
QFrame#monitorDot[state="queued"]  { background: #d98522; }
QFrame#monitorDot[state="paused"]  { background: #d98522; }
QFrame#monitorDot[state="idle"]    { background: #9a9a9a; }

QLabel[mRole="connName"] {
    color: #1a1a1a;
    font-size: 12.5px;
}

QLabel[mRole="connMeta"] {
    color: #6b6b6b;
    font-size: 11.5px;
}

QLabel[mRole="kicker"] {
    color: #6b6b6b;
    font-size: 11.5px;
}

QLabel[mRole="heroText"] {
    color: #111111;
    font-size: 20px;
    font-weight: 600;
}

QLabel[mRole="statKey"] {
    color: #8a8a8a;
    font-size: 11px;
}

QLabel[mRole="statValue"] {
    color: #111111;
    font-size: 16px;
    font-weight: 600;
}

QLabel[mRole="statSuffix"] {
    color: #6b6b6b;
    font-size: 11px;
    padding-bottom: 2px;
}

QLabel[mRole="nowLabel"] {
    color: #6b6b6b;
    font-size: 11.5px;
}

QLabel[mRole="nowValue"] {
    color: #111111;
    font-size: 13px;
    font-weight: 600;
}

QLabel[mRole="hintText"] {
    color: #8a8a8a;
    font-size: 11px;
}

QLabel[mRole="cardTitle"] {
    color: #1f1f1f;
    font-size: 12.5px;
    font-weight: 600;
}

QLabel[mRole="rowLeft"] {
    color: #6b6b6b;
    font-size: 12px;
}

QLabel[mRole="rowRight"] {
    color: #1f1f1f;
    font-size: 12px;
}

QLabel[mRole="tlTime"] {
    color: #8a8a8a;
    font-size: 11.5px;
}

QLabel[mRole="tlEvent"] {
    color: #0f6cbd;
    font-size: 12px;
}

QLabel[mRole="tlDetail"] {
    color: #3a3a3a;
    font-size: 12px;
}

QLabel[mRole="tlResult"] {
    color: #2ea06e;
    font-size: 11px;
}

QProgressBar#monitorBar {
    background: #e6e6e6;
    border: none;
    border-radius: 3px;
}

QProgressBar#monitorBar::chunk {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2ea06e, stop:1 #6fd3a8);
}

QPushButton#monitorPrimary {
    background: #0f6cbd;
    color: #ffffff;
    border: 1px solid #0f6cbd;
    border-radius: 6px;
    padding: 0 20px;
    font-size: 12.5px;
    font-weight: 600;
}

QPushButton#monitorPrimary:hover { background: #1a7fd4; }

/* 【■】完全停止小方钮（2026-11-07）：未启动=黑底白方块不可点；
   启动后=蓝底白方块可点（对齐框架 TaskCard 的 Stop 观感）。 */
QPushButton#monitorStopIdle {
    background: #1f1f1f;
    color: #ffffff;
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    padding: 0;
}

QPushButton#monitorStopIdle:hover { background: #262626; }

QPushButton#monitorStopPrimary {
    background: #0f6cbd;
    color: #ffffff;
    border: 1px solid #0f6cbd;
    border-radius: 6px;
    padding: 0;
}

QPushButton#monitorStopPrimary:hover { background: #1a7fd4; }

QPushButton#monitorGhost {
    background: transparent;
    color: #333333;
    border: 1px solid #d6d6d6;
    border-radius: 6px;
    padding: 0 12px;
    font-size: 12px;
}

QPushButton#monitorGhost:hover { background: #f0f0f0; }

/* ---- 布局编辑态 ---- */

QPushButton#monitorEditBtn {
    background: #f5f5f5;
    color: #444444;
    border: 1px solid #d6d6d6;
    border-radius: 4px;
    font-size: 12px;
    padding: 0;
}

QPushButton#monitorEditBtn:hover {
    background: #e8e8e8;
    color: #111111;
}

QPushButton#monitorRestore {
    background: transparent;
    color: #0f6cbd;
    border: 1px dashed #c9c9c9;
    border-radius: 12px;
    padding: 0 10px;
    font-size: 11.5px;
}

QPushButton#monitorRestore:hover { background: #f0f0f0; }

QLabel[mRole="hiddenHint"] {
    color: #8a8a8a;
    font-size: 11px;
}

QLabel[mEditable="true"] {
    border-bottom: 1px dashed #c9c9c9;
}

QLabel[mEditable="true"]:hover {
    background: rgba(15, 108, 189, 26);
    border-bottom: 1px dashed #0f6cbd;
}

/* ---- 分数预测 / 六维 ---- */

QLabel[mRole="scoreValue"] {
    color: #0f6cbd;
    font-size: 24px;
    font-weight: 600;
}

QLabel[mRole="skillTag"] {
    color: #6b6b6b;
    font-size: 11.5px;
}

QLabel[mRole="attrName"] {
    color: #8a8a8a;
    font-size: 11px;
}

QLabel[mRole="attrValue"] {
    color: #111111;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#monitorEditEntry {
    background: transparent;
    color: #6b6b6b;
    border: 1px solid #d6d6d6;
    border-radius: 6px;
    font-size: 13px;
    padding: 0;
}

QPushButton#monitorEditEntry:hover {
    background: #f0f0f0;
    color: #111111;
}

QLabel[mRole="skillValue"] {
    color: #111111;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#monitorToggle:hover {
    background: #f0f0f0;
}

QLabel[mRole="skillGain"] { color: #1c7a53; font-size: 11.5px; }
