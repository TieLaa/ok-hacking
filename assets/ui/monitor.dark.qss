/* 监控页 · 深色主题（改完存盘自动生效，不用重启） */

QWidget#monitorRoot {
    background: transparent;
}

QFrame#monitorCard {
    background: #2b2b2b;
    border: 1px solid #353535;
    border-radius: 8px;
}

QFrame#monitorDivider {
    background: #383838;
}

QFrame#monitorSplitHandle {
    background: #383838;
    border-radius: 1px;
}

/* 编辑态把手有 7px 宽好抓，但只画中间 1px，看起来还是细线 */
QFrame#monitorSplitHandle[editing="true"] {
    margin: 0 3px;
}

QFrame#monitorSplitHandle:hover {
    background: #4cc2ff;
}

QFrame#monitorRow {
    border-bottom: 1px dashed #383838;
}

QFrame#monitorHalo {
    background: rgba(78, 203, 141, 46);
    border-radius: 8px;
}

QFrame#monitorDot {
    background: #6f6f6f;
    border-radius: 4px;
}

QFrame#monitorDot[state="running"] { background: #4ecb8d; }
QFrame#monitorDot[state="queued"]  { background: #f0a44a; }
QFrame#monitorDot[state="paused"]  { background: #f0a44a; }
QFrame#monitorDot[state="idle"]    { background: #6f6f6f; }

QLabel[mRole="connName"] {
    color: #e8e8e8;
    font-size: 12.5px;
}

QLabel[mRole="connMeta"] {
    color: #9a9a9a;
    font-size: 11.5px;
}

QLabel[mRole="kicker"] {
    color: #9a9a9a;
    font-size: 11.5px;
}

QLabel[mRole="heroText"] {
    color: #e8e8e8;
    font-size: 20px;
    font-weight: 600;
}

QLabel[mRole="statKey"] {
    color: #6f6f6f;
    font-size: 11px;
}

QLabel[mRole="statValue"] {
    color: #e8e8e8;
    font-size: 16px;
    font-weight: 600;
}

QLabel[mRole="statSuffix"] {
    color: #9a9a9a;
    font-size: 11px;
    padding-bottom: 2px;
}

QLabel[mRole="nowLabel"] {
    color: #9a9a9a;
    font-size: 11.5px;
}

QLabel[mRole="nowValue"] {
    color: #e8e8e8;
    font-size: 13px;
    font-weight: 600;
}

QLabel[mRole="hintText"] {
    color: #6f6f6f;
    font-size: 11px;
}

QLabel[mRole="cardTitle"] {
    color: #dcdcdc;
    font-size: 12.5px;
    font-weight: 600;
}

QLabel[mRole="rowLeft"] {
    color: #9a9a9a;
    font-size: 12px;
}

QLabel[mRole="rowRight"] {
    color: #e2e2e2;
    font-size: 12px;
}

QLabel[mRole="tlTime"] {
    color: #6f6f6f;
    font-size: 11.5px;
}

QLabel[mRole="tlEvent"] {
    color: #4cc2ff;
    font-size: 12px;
}

QLabel[mRole="tlDetail"] {
    color: #bdbdbd;
    font-size: 12px;
}

QLabel[mRole="tlResult"] {
    color: #4ecb8d;
    font-size: 11px;
}

QProgressBar#monitorBar {
    background: #3c3c3c;
    border: none;
    border-radius: 3px;
}

QProgressBar#monitorBar::chunk {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4ecb8d, stop:1 #7fe0b0);
}

QPushButton#monitorPrimary {
    background: #4cc2ff;
    color: #062430;
    border: 1px solid #4cc2ff;
    border-radius: 6px;
    padding: 0 20px;
    font-size: 12.5px;
    font-weight: 600;
}

QPushButton#monitorPrimary:hover { background: #6ecfff; }

/* 【■】完全停止小方钮（2026-11-07）：未启动=黑底白方块不可点；
   启动后=蓝底白方块可点（对齐框架 TaskCard 的 Stop 观感）。 */
QPushButton#monitorStopIdle {
    background: #1f1f1f;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    padding: 0;
}

QPushButton#monitorStopIdle:hover { background: #262626; }

QPushButton#monitorStopPrimary {
    background: #4cc2ff;
    color: #062430;
    border: 1px solid #4cc2ff;
    border-radius: 6px;
    padding: 0;
}

QPushButton#monitorStopPrimary:hover { background: #6ecfff; }

QPushButton#monitorGhost {
    background: transparent;
    color: #cfcfcf;
    border: 1px solid #454545;
    border-radius: 6px;
    padding: 0 12px;
    font-size: 12px;
}

QPushButton#monitorGhost:hover { background: #333333; }

/* ---- 布局编辑态 ---- */

QPushButton#monitorEditBtn {
    background: #333333;
    color: #cfcfcf;
    border: 1px solid #454545;
    border-radius: 4px;
    font-size: 12px;
    padding: 0;
}

QPushButton#monitorEditBtn:hover {
    background: #3f3f3f;
    color: #ffffff;
}

QPushButton#monitorRestore {
    background: transparent;
    color: #8fc4e8;
    border: 1px dashed #4a4a4a;
    border-radius: 12px;
    padding: 0 10px;
    font-size: 11.5px;
}

QPushButton#monitorRestore:hover { background: #333333; }

QLabel[mRole="hiddenHint"] {
    color: #6f6f6f;
    font-size: 11px;
}

QLabel[mEditable="true"] {
    border-bottom: 1px dashed #4a4a4a;
}

QLabel[mEditable="true"]:hover {
    background: rgba(76, 194, 255, 30);
    border-bottom: 1px dashed #4cc2ff;
}

/* ---- 分数预测 / 六维 ---- */

QLabel[mRole="scoreValue"] {
    color: #4cc2ff;
    font-size: 24px;
    font-weight: 600;
}

QLabel[mRole="skillTag"] {
    color: #9a9a9a;
    font-size: 11.5px;
}

QLabel[mRole="attrName"] {
    color: #6f6f6f;
    font-size: 11px;
}

QLabel[mRole="attrValue"] {
    color: #e8e8e8;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#monitorEditEntry {
    background: transparent;
    color: #9a9a9a;
    border: 1px solid #454545;
    border-radius: 6px;
    font-size: 13px;
    padding: 0;
}

QPushButton#monitorEditEntry:hover {
    background: #333333;
    color: #ffffff;
}

QLabel[mRole="skillValue"] {
    color: #e8e8e8;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#monitorToggle:hover {
    background: #333333;
}

QLabel[mRole="skillGain"] { color: #4ecb8d; font-size: 11.5px; }
